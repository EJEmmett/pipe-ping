# Copy this file to .env and fill in your token and repositories.

# A GitHub token that can read Actions on the repositories below.
PIPE_PING_GITHUB__TOKEN=github_pat_...

# The repositories to watch, as a JSON list.
PIPE_PING_GITHUB__REPOS='["owner/repo", "owner/other-repo"]'

# Everything below is optional. Uncomment a line to change its default.

# Point at a GitHub Enterprise server instead of github.com.
# PIPE_PING_GITHUB__API_URL=https://github.example.com/api/v3

# How many recent runs to look at in each repository.
# PIPE_PING_GITHUB__RUNS_PER_REPO=20

# Where to keep the database. Defaults to your user data folder.
# PIPE_PING_SQLITE__PATH=/path/to/pipe_ping.db

# Where to write the log file and how much of it to keep.
# PIPE_PING_STRUCTURED_LOGGING__PATH=/path/to/pipe_ping.log
# PIPE_PING_STRUCTURED_LOGGING__MAX_BYTES=10485760
# PIPE_PING_STRUCTURED_LOGGING__BACKUP_COUNT=5
