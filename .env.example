# Copy this file to the path printed by `pipe-ping config-path`, or to `.env`
# in the directory you run Pipe-Ping from, then set your token and repositories.

# A GitHub token with read access to Actions on the repositories below.
PIPE_PING_GITHUB__TOKEN=github_pat_...

# The repositories to monitor, as a JSON list.
PIPE_PING_GITHUB__REPOS='["owner/repo", "owner/other-repo"]'

# The remaining settings are optional. Uncomment a line to override its default.

# The API URL of a GitHub Enterprise Server instance.
# PIPE_PING_GITHUB__API_URL=https://github.example.com/api/v3

# The number of recent workflow runs to check in each repository.
# PIPE_PING_GITHUB__RUNS_PER_REPO=20

# The database location. Defaults to the platform's user data directory.
# PIPE_PING_SQLITE__PATH=/path/to/pipe_ping.db

# The log file location, its maximum size in bytes before rotation, and the
# number of rotated files to keep. Defaults to the platform's user log directory.
# PIPE_PING_STRUCTURED_LOGGING__PATH=/path/to/pipe_ping.log
# PIPE_PING_STRUCTURED_LOGGING__MAX_BYTES=10485760
# PIPE_PING_STRUCTURED_LOGGING__BACKUP_COUNT=5
